# Copy to .env for local development. NEVER put real passwords in this file (it is committed to git).
# Put ONLY the connection string as the value (no quotes, no "MONGODB_URI=" twice, no < > brackets).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentdb?retryWrites=true&w=majority

# Allowed frontend origin(s), comma-separated, exact URLs (wildcards like https://*.vercel.app also work but allow ANY Vercel app).
FRONTEND_URL=http://localhost:5500,https://your-app.vercel.app

# Optional
# DB_NAME=studentdb
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
PORT=5000
